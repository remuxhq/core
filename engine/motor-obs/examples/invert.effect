// The picture's colours inverted: `remux scene filter invert.effect`.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float time;
uniform float2 resolution;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 PSInvert(VertData v_in) : TARGET
{
	float4 pixel = image.Sample(def_sampler, v_in.uv);
	return float4(1.0 - pixel.rgb, pixel.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSInvert(v_in);
	}
}
